# ── Base de données (production) ────────────────────────────────────────────
# Non défini = SQLite local (server/financial_db.sqlite), pratique en dev mais
# à éviter en prod (fichier local, perdu au redéploiement sur la plupart des
# hébergeurs, aucune vraie concurrence d'accès).
#
# Défini = PostgreSQL. Format standard :
#   postgres://<utilisateur>:<mot_de_passe>@<hôte>:<port>/<base>
#
# Si le conteneur Node tourne DANS le même stack Docker Swarm que Postgres,
# <hôte> est le nom du service Postgres (ex: "postgres"), pas une IP.
# Si Node tourne EN DEHORS du swarm, <hôte> est l'IP du serveur (ou son nom
# DNS), et le port de Postgres doit être publié par le service (ports: en mode
# host ou ingress dans le docker-compose du stack).
DATABASE_URL=postgres://onda_user:CHANGE_MOI@localhost:5432/onda_prod

# Mettre à true seulement si Postgres exige une connexion chiffrée (rare pour
# une connexion interne au même réseau Docker/VPC — la plupart des managés
# type RDS/Render/Neon l'exigent, une instance auto-hébergée en interne non).
DB_SSL=false

# ── Authentification ────────────────────────────────────────────────────────
# Obligatoire en prod : sans cette variable, server.js retombe sur un secret
# codé en dur dans le code source (voir server.js:66) — n'importe qui peut
# alors forger un token valide pour n'importe quel compte.
JWT_SECRET=CHANGE_MOI_valeur_longue_et_aleatoire

# ── Paiement (Paystack) ─────────────────────────────────────────────────────
# Utiliser les clés LIVE (sk_live_/pk_live_) en prod — les clés de test
# (sk_test_/pk_test_) n'acceptent aucun paiement réel.
PAYSTACK_SECRET_KEY=
VITE_PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Mode de déploiement client (simulator | pro) ────────────────────────────
VITE_APP_MODE=pro

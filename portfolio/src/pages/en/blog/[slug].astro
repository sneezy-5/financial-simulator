---
import PostDetailView from '../../../components/views/PostDetailView.astro';
import { slugPaths } from '../../../lib/paths';

export async function getStaticPaths() {
  return slugPaths('posts', 'en');
}

const { entry, hasAlt } = Astro.props;
---
<PostDetailView lang="en" entry={entry} hasAlt={hasAlt} />

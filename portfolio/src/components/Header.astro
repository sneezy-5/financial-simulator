---
import type { Lang } from '../consts';
import { SITE } from '../consts';
import { useT, localePath, homePath } from '../i18n/ui';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  lang: Lang;
  /** section active pour l’état visuel du menu */
  active?: 'projects' | 'about' | 'blog' | 'contact' | null;
  /** chemins équivalents par langue, pour le sélecteur de langue */
  alternates: Partial<Record<Lang, string>>;
}
const { lang, active = null, alternates } = Astro.props;
const t = useT(lang);
const other: Lang = lang === 'fr' ? 'en' : 'fr';
const otherHref = alternates[other] ?? homePath(other);

const items = [
  { id: 'projects', href: localePath(lang, 'projects'), label: t('nav.projects') },
  { id: 'about', href: localePath(lang, 'about'), label: t('nav.about') },
  { id: 'blog', href: localePath(lang, 'blog'), label: t('nav.blog') },
  { id: 'contact', href: localePath(lang, 'contact'), label: t('nav.contact') },
] as const;

const initials = SITE.author
  .replace(/[⟨⟩]/g, '')
  .trim()
  .split(/\s+/)
  .map((w) => w[0])
  .slice(0, 2)
  .join('')
  .toUpperCase();
---

<a class="skip" href="#main">{t('nav.skipToContent')}</a>
<header class="hd">
  <div class="page hd-inner">
    <a class="brand" href={homePath(lang)} aria-label={SITE.author}>
      <span class="brand-mark">{initials || '·'}</span>
      <span class="brand-name">{SITE.author.replace(/[⟨⟩]/g, '')}</span>
    </a>

    <nav class="nav" aria-label={lang === 'fr' ? 'Navigation principale' : 'Main navigation'}>
      {items.map((it) => (
        <a href={it.href} aria-current={active === it.id ? 'page' : undefined}>{it.label}</a>
      ))}
    </nav>

    <div class="hd-actions">
      <a class="lang" href={otherHref} hreflang={other} rel="alternate">{t('lang.switch')}</a>
      <ThemeToggle lang={lang} />
    </div>
  </div>
</header>

<style>
  .skip {
    position: absolute;
    left: -9999px;
    top: 0;
    background: var(--accent);
    color: #fff;
    padding: 0.6rem 1rem;
    z-index: 100;
    border-radius: 0 0 var(--r-sm) 0;
  }
  .skip:focus { left: 0; }

  .hd {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: saturate(1.4) blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .hd-inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 3.75rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .brand-mark {
    display: grid;
    place-items: center;
    width: 1.85rem;
    height: 1.85rem;
    border-radius: 7px;
    background: var(--accent);
    color: #fff;
    font-size: 0.8rem;
    font-weight: 700;
  }
  :root[data-theme='dark'] .brand-mark { color: #08201e; }
  .brand-name { white-space: nowrap; }

  .nav {
    display: flex;
    gap: 1.1rem;
    margin-left: auto;
    font-size: 0.95rem;
  }
  .nav a {
    text-decoration: none;
    color: var(--text-soft);
    padding: 0.25rem 0;
  }
  .nav a:hover { color: var(--text); }
  .nav a[aria-current='page'] {
    color: var(--text);
    box-shadow: inset 0 -2px 0 var(--accent);
  }

  .hd-actions {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .lang {
    font-size: 0.9rem;
    color: var(--text-soft);
    text-decoration: none;
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    padding: 0.4rem 0.7rem;
  }
  .lang:hover { color: var(--text); border-color: var(--text-faint); }

  @media (max-width: 640px) {
    .brand-name { display: none; }
    .nav { gap: 0.85rem; font-size: 0.9rem; }
  }
  @media (max-width: 460px) {
    .hd-inner { flex-wrap: wrap; min-height: 0; padding-block: 0.6rem; gap: 0.6rem 1rem; }
    .nav { order: 3; width: 100%; margin-left: 0; justify-content: space-between; }
  }
</style>

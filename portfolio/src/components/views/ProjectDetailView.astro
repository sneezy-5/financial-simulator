---
import { render } from 'astro:content';
import type { Lang } from '../../consts';
import { SITE } from '../../consts';
import { useT, localePath } from '../../i18n/ui';
import type { Project } from '../../lib/content';
import Base from '../../layouts/Base.astro';

interface Props { lang: Lang; entry: Project; hasAlt: boolean }
const { lang, entry, hasAlt } = Astro.props;
const t = useT(lang);
const { Content } = await render(entry);
const d = entry.data;

const other: Lang = lang === 'fr' ? 'en' : 'fr';
const alternates: Partial<Record<Lang, string>> = { [lang]: localePath(lang, 'projects', d.key) };
if (hasAlt) alternates[other] = localePath(other, 'projects', d.key);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: d.title,
    abstract: d.summary,
    inLanguage: lang,
    url: new URL(localePath(lang, 'projects', d.key), SITE.url).href,
    author: { '@type': 'Person', name: SITE.author },
    dateCreated: d.year,
    keywords: d.stack.join(', '),
    ...(d.url ? { sameAs: d.url } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t('projects.title'), item: new URL(localePath(lang, 'projects'), SITE.url).href },
      { '@type': 'ListItem', position: 2, name: d.title },
    ],
  },
];
---

<Base
  lang={lang}
  title={`${d.title} — ${SITE.author.replace(/[⟨⟩]/g, '')}`}
  description={d.summary}
  alternates={alternates}
  active="projects"
  ogType="article"
  jsonLd={jsonLd}
>
  <article class="section">
    <div class="page">
      <a class="back" href={localePath(lang, 'projects')}>&larr; {t('project.back')}</a>
      <header class="ph stack" style="--flow: 0.75rem;">
        <h1>{d.title}</h1>
        <p class="lead">{d.summary}</p>
        <dl class="meta">
          <div><dt>{t('project.role')}</dt><dd>{d.role}</dd></div>
          <div><dt>{t('project.year')}</dt><dd>{d.year}</dd></div>
          <div>
            <dt>{t('project.stack')}</dt>
            <dd class="stack-tags">{d.stack.map((s) => <span class="tag">{s}</span>)}</dd>
          </div>
        </dl>
        {d.url && (
          <p><a class="btn btn--primary" href={d.url} target="_blank" rel="noopener">{t('project.visit')} &rarr;</a></p>
        )}
      </header>

      <div class="prose">
        <Content />
      </div>
    </div>
  </article>
</Base>

<style>
  .back { display: inline-block; margin-bottom: 1.75rem; color: var(--text-soft); text-decoration: none; font-size: 0.95rem; }
  .back:hover { color: var(--text); }
  .ph { max-width: 46rem; }
  .ph h1 { font-size: clamp(1.7rem, 4.5vw, 2.5rem); }
  .meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 1rem 1.5rem;
    margin: 0.5rem 0 0;
    padding: 1.1rem 0;
    border-block: 1px solid var(--line);
  }
  .meta dt { font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-faint); }
  .meta dd { margin: 0.2rem 0 0; }
  .stack-tags { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .prose { margin-top: 2.5rem; }
</style>

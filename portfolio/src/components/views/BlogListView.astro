---
import type { Lang } from '../../consts';
import { SITE } from '../../consts';
import { useT, localePath } from '../../i18n/ui';
import { getPosts } from '../../lib/content';
import Base from '../../layouts/Base.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const posts = await getPosts(lang);

const fmtDate = (d: Date) =>
  d.toLocaleDateString(lang === 'fr' ? 'fr-FR' : 'en-GB', { year: 'numeric', month: 'long', day: 'numeric' });

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: `${t('blog.title')} — ${SITE.author.replace(/[⟨⟩]/g, '')}`,
  inLanguage: lang,
  blogPost: posts.map((p) => ({
    '@type': 'BlogPosting',
    headline: p.data.title,
    datePublished: p.data.published.toISOString(),
    url: new URL(localePath(lang, 'blog', p.data.key), SITE.url).href,
  })),
};
---

<Base
  lang={lang}
  title={`${t('blog.title')} — ${SITE.author.replace(/[⟨⟩]/g, '')}`}
  description={t('blog.lead')}
  alternates={{ fr: localePath('fr', 'blog'), en: localePath('en', 'blog') }}
  active="blog"
  jsonLd={jsonLd}
>
  <section class="section">
    <div class="page stack" style="--flow: 0.75rem; max-width: 46rem;">
      <h1>{t('blog.title')}</h1>
      <p class="lead">{t('blog.lead')}</p>
    </div>
  </section>

  <section class="section">
    <div class="page">
      <ul class="posts">
        {posts.map((post) => (
          <li>
            <a href={localePath(lang, 'blog', post.data.key)}>
              <time datetime={post.data.published.toISOString()}>{fmtDate(post.data.published)}</time>
              <h2>{post.data.title}</h2>
              <p class="muted">{post.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .posts { list-style: none; padding: 0; }
  .posts li + li { border-top: 1px solid var(--line); }
  .posts a { display: block; padding: 1.5rem 0; text-decoration: none; }
  .posts time { color: var(--text-faint); font-size: 0.88rem; }
  .posts h2 { font-size: 1.2rem; margin: 0.3rem 0 0.4rem; }
  .posts a:hover h2 { text-decoration: underline; text-underline-offset: 3px; }
</style>

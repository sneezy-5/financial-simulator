---
import { LINKS, hasLink } from '../consts';
import type { Lang } from '../consts';

interface Props {
  lang: Lang;
  /** 'row' = boutons avec libellé ; 'icons' = pastilles icône seule */
  variant?: 'row' | 'icons';
}
const { lang, variant = 'row' } = Astro.props;

const valid = hasLink;

type Item = { key: string; label: string; href: string; icon: string; primary?: boolean };

const ICONS: Record<string, string> = {
  linkedin:
    '<path d="M4.98 3.5A2.5 2.5 0 1 1 0 3.5a2.5 2.5 0 0 1 4.98 0zM.4 8.02h4.16V24H.4zM8.34 8.02h3.99v2.18h.06c.56-1.05 1.92-2.16 3.95-2.16 4.22 0 5 2.78 5 6.4V24h-4.16v-6.73c0-1.6-.03-3.67-2.24-3.67-2.24 0-2.58 1.75-2.58 3.55V24H8.34z"/>',
  github:
    '<path d="M12 .5A11.5 11.5 0 0 0 8.37 22.9c.57.1.78-.25.78-.55v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.34-1.28-1.7-1.28-1.7-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.2 1.77 1.2 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.18-3.08-.12-.29-.51-1.46.11-3.04 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.5 3.17-1.18 3.17-1.18.63 1.58.24 2.75.12 3.04.74.8 1.18 1.82 1.18 3.08 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .3.2.66.79.55A11.5 11.5 0 0 0 12 .5z"/>',
  whatsapp:
    '<path d="M12.04 2C6.6 2 2.2 6.4 2.2 11.84c0 1.94.51 3.76 1.4 5.34L2 22l4.94-1.55a9.8 9.8 0 0 0 5.1 1.42h.01c5.44 0 9.84-4.4 9.84-9.84C21.9 6.4 17.48 2 12.04 2zm5.72 13.95c-.24.68-1.4 1.3-1.93 1.34-.5.06-1.12.08-1.8-.11-.42-.13-.95-.3-1.63-.6-2.87-1.24-4.74-4.13-4.88-4.32-.14-.19-1.17-1.55-1.17-2.96s.74-2.1 1-2.39c.26-.29.57-.36.76-.36l.55.01c.18.01.42-.07.65.5.24.58.82 2 .9 2.14.07.14.12.31.02.5-.1.19-.14.31-.29.48-.14.17-.3.38-.43.5-.14.14-.29.3-.13.58.17.29.74 1.22 1.59 1.98 1.09.97 2 1.28 2.29 1.42.29.14.46.12.63-.07.17-.19.72-.84.91-1.13.19-.29.38-.24.65-.14.26.1 1.68.79 1.97.93.29.14.48.22.55.34.07.12.07.72-.17 1.4z"/>',
  mail:
    '<path d="M2 5.5A1.5 1.5 0 0 1 3.5 4h17A1.5 1.5 0 0 1 22 5.5v13a1.5 1.5 0 0 1-1.5 1.5h-17A1.5 1.5 0 0 1 2 18.5zm2.2.5 7.8 5.7L19.8 6zM20 8.13l-7.4 5.42a1 1 0 0 1-1.2 0L4 8.13V18h16z"/>',
};

const items: Item[] = [
  valid(LINKS.linkedin) && { key: 'linkedin', label: 'LinkedIn', href: LINKS.linkedin, icon: ICONS.linkedin, primary: true },
  valid(LINKS.github) && { key: 'github', label: 'GitHub', href: LINKS.github, icon: ICONS.github },
  valid(LINKS.whatsapp) && { key: 'whatsapp', label: 'WhatsApp', href: LINKS.whatsapp, icon: ICONS.whatsapp },
  valid(LINKS.email) && { key: 'mail', label: lang === 'fr' ? 'E-mail' : 'Email', href: `mailto:${LINKS.email}`, icon: ICONS.mail },
].filter(Boolean) as Item[];
---

<ul class:list={['social', `social--${variant}`]}>
  {items.map((it) => (
    <li>
      <a
        href={it.href}
        class:list={['social-link', { 'is-primary': it.primary }]}
        target={it.href.startsWith('mailto:') ? undefined : '_blank'}
        rel={it.href.startsWith('mailto:') ? 'me' : 'me noopener'}
        aria-label={it.label}
      >
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true" set:html={it.icon} />
        {variant === 'row' && <span>{it.label}</span>}
      </a>
    </li>
  ))}
</ul>

<style>
  .social { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    background: var(--surface);
    color: var(--text-soft);
    font-size: 0.9rem;
    font-weight: 500;
    padding: 0.5rem 0.8rem;
    transition: border-color 0.12s ease, color 0.12s ease, transform 0.12s ease;
  }
  .social--icons .social-link { padding: 0.55rem; }
  .social-link:hover { color: var(--text); border-color: var(--text-faint); transform: translateY(-1px); }
  .social-link.is-primary {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
  :root[data-theme='dark'] .social-link.is-primary { color: #08201e; }
  .social-link.is-primary:hover { color: #fff; }
  :root[data-theme='dark'] .social-link.is-primary:hover { color: #08201e; }
  .social-link svg { flex-shrink: 0; }
</style>

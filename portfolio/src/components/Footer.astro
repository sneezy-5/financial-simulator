---
import type { Lang } from '../consts';
import { SITE } from '../consts';
import { useT, localePath } from '../i18n/ui';
import Social from './Social.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const year = new Date().getFullYear();
---

<footer class="ft">
  <div class="page ft-inner">
    <div>
      <p class="ft-name">{SITE.author.replace(/[⟨⟩]/g, '')}</p>
      <p class="muted">
        &copy; {SITE.since}&ndash;{year} &middot; {SITE.location} &middot; {t('footer.rights')}
      </p>
      <Social lang={lang} variant="icons" />
    </div>
    <nav class="ft-nav" aria-label={lang === 'fr' ? 'Pied de page' : 'Footer'}>
      <a href={localePath(lang, 'projects')}>{t('nav.projects')}</a>
      <a href={localePath(lang, 'about')}>{t('nav.about')}</a>
      <a href={localePath(lang, 'blog')}>{t('nav.blog')}</a>
      <a href={localePath(lang, 'contact')}>{t('nav.contact')}</a>
    </nav>
  </div>
</footer>

<style>
  .ft {
    border-top: 1px solid var(--line);
    background: var(--bg-soft);
    padding-block: 2.5rem;
    font-size: 0.9rem;
  }
  .ft-inner {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .ft-name { font-weight: 600; }
  .ft :global(.social) { margin-top: 0.9rem; }
  .ft-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    align-content: flex-start;
  }
  .ft-nav a { color: var(--text-soft); text-decoration: none; }
  .ft-nav a:hover { color: var(--text); }
</style>

# URL de l'API backend ONDA (le serveur reste le même que le SaaS, ce site n'est qu'une vitrine)
VITE_API_URL=https://api.eonda.online/api

# URL de l'application principale ONDA (lien "Retour à l'accueil")
VITE_MAIN_APP_URL=https://eonda.online

# Clé PUBLIQUE Paystack (jamais la clé secrète !) pour le paiement en ligne de la licence.
# Ce site est déployé séparément de l'app principale, il a donc besoin de sa propre clé publique.
VITE_PAYSTACK_PUBLIC_KEY=

# URL directe du fichier installeur. Le bouton "Télécharger" pointe toujours vers cette valeur —
# à renseigner avant le déploiement en production.
VITE_DOWNLOAD_URL=

# Vente de licences en ligne mise en pause pour le moment : remplace le formulaire d'achat par
# un bandeau "Ventes temporairement suspendues" (les liens de contact WhatsApp/email restent
# visibles). Suspendu par défaut si absent. Mettre à "false" pour réactiver la vente en libre-service.
VITE_SALES_PAUSED=true

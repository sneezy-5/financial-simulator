# Ce fichier ne contient QUE des variables VITE_* — lues par Vite à la
# COMPILATION du frontend (bakées dans le bundle statique, jamais au runtime
# serveur). Ce ne sont donc jamais des secrets à proprement parler
# (VITE_PAYSTACK_PUBLIC_KEY est justement la clé PUBLIQUE de Paystack).
#
# Tout secret serveur (clé Paystack SECRÈTE, SMTP, JWT, base de données, IA)
# vit exclusivement dans server/.env — voir server/.env.example.

VITE_PAYSTACK_PUBLIC_KEY=pk_live_...

# Mode de déploiement (simulator | pro)
# 'simulator' limite l'affichage aux modules publics (Bulletins, Congés, STC)
# En production sur la version complète, définissez cette variable sur 'pro'
VITE_APP_MODE=pro

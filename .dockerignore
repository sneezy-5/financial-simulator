node_modules
server/node_modules
# enterprise-site n'est PAS ignoré en bloc : src/App.vue importe en dur
# enterprise-site/src/App.vue (voir src/App.vue, "LandingPage") — un `COPY`
# explicite dans le Dockerfile en dépend. Seuls node_modules/dist (~40 Mo,
# jamais utilisés par ce build) sont exclus pour garder le contexte léger.
enterprise-site/node_modules
enterprise-site/dist

# .env (racine) N'EST PAS ignoré, volontairement : le stage frontend-build en
# a besoin pour les variables VITE_* (bakées dans le bundle à la compilation).
# Il ne contient plus que ça depuis la séparation avec server/.env — voir le
# commentaire en tête de .env. Tout le reste (secrets serveur : Paystack,
# SMTP, JWT, base de données) est injecté par le stack Docker au déploiement,
# jamais copié depuis le poste de dev.
server/.env
.env.local
.env.*.local
server/.env.*

# Données locales / builds précédents
dist
dist-ssr
dist_electron
server/database.sqlite
server/*.sqlite
server/uploads
uploads

# Fichiers de scratch / debug jamais destinés au déploiement
server/__test_*.js
server/__dump_sheet.js
server/__pdf_to_png.js

# Divers
.git
.vscode
.idea
*.log
tests
node.exe
